{
  "name": "sxpt-agent",
  "displayName": "SXPT AI Coding Agent",
  "description": "实训平台内置 VS Code 的 AI 编程 Agent：原生终端对话、会话历史、QuickPick 设置、Diff 审核与撤销，支持局域网 HTTP code-server。",
  "version": "0.3.2",
  "publisher": "sxpt",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Education",
    "Other"
  ],
  "keywords": [
    "ai",
    "coding",
    "agent",
    "training",
    "education"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ptnAgent",
          "title": "AI Coding Agent",
          "icon": "media/agent.svg"
        }
      ]
    },
    "views": {
      "ptnAgent": [
        {
          "id": "ptnAgent.sessionView",
          "name": "对话",
          "icon": "media/agent.svg",
          "contextualTitle": "AI Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "ptnAgent.openTerminalChat",
        "title": "打开原生备用对话",
        "category": "AI Agent"
      },
      {
        "command": "ptnAgent.history",
        "title": "历史会话",
        "category": "AI Agent",
        "icon": "$(history)"
      },
      {
        "command": "ptnAgent.openChat",
        "title": "打开对话",
        "category": "AI Agent",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "ptnAgent.ask",
        "title": "输入任务…",
        "category": "AI Agent",
        "icon": "$(edit)"
      },
      {
        "command": "ptnAgent.stop",
        "title": "停止当前任务",
        "category": "AI Agent",
        "icon": "$(debug-stop)"
      },
      {
        "command": "ptnAgent.newSession",
        "title": "新建对话",
        "category": "AI Agent",
        "icon": "$(add)"
      },
      {
        "command": "ptnAgent.undoLastPatch",
        "title": "撤销上次 AI 修改",
        "category": "AI Agent",
        "icon": "$(discard)"
      },
      {
        "command": "ptnAgent.settings",
        "title": "打开设置",
        "category": "AI Agent",
        "icon": "$(gear)"
      },
      {
        "command": "ptnAgent.pickModel",
        "title": "切换模型",
        "category": "AI Agent"
      },
      {
        "command": "ptnAgent.pickMode",
        "title": "切换审批模式",
        "category": "AI Agent"
      },
      {
        "command": "ptnAgent.explainSelection",
        "title": "解释选中代码",
        "category": "AI Agent"
      },
      {
        "command": "ptnAgent.refactorSelection",
        "title": "重构选中代码",
        "category": "AI Agent"
      },
      {
        "command": "ptnAgent.generateTests",
        "title": "生成单元测试",
        "category": "AI Agent"
      },
      {
        "command": "ptnAgent.analyzeProblem",
        "title": "分析当前错误",
        "category": "AI Agent"
      },
      {
        "command": "ptnAgent.fixProblems",
        "title": "修复当前问题",
        "category": "AI Agent"
      },
      {
        "command": "ptnAgent.explainProject",
        "title": "理解项目结构",
        "category": "AI Agent"
      },
      {
        "command": "ptnAgent.gotoProblem",
        "title": "定位问题",
        "category": "AI Agent"
      },
      {
        "command": "ptnAgent.showContext",
        "title": "查看当前上下文",
        "category": "AI Agent"
      },
      {
        "command": "ptnAgent.showProjectOutline",
        "title": "查看项目结构摘要",
        "category": "AI Agent"
      },
      {
        "command": "ptnAgent.runTests",
        "title": "运行测试或构建",
        "category": "AI Agent"
      },
      {
        "command": "ptnAgent.runCommand",
        "title": "运行命令",
        "category": "AI Agent"
      },
      {
        "command": "ptnAgent.checkPi",
        "title": "检查 Agent 运行环境",
        "category": "AI Agent"
      },
      {
        "command": "ptnAgent.approval.allow",
        "title": "允许",
        "category": "AI Agent",
        "icon": "$(check)"
      },
      {
        "command": "ptnAgent.approval.deny",
        "title": "拒绝",
        "category": "AI Agent",
        "icon": "$(close)"
      },
      {
        "command": "ptnAgent.approval.diff",
        "title": "查看修改（Diff）",
        "category": "AI Agent",
        "icon": "$(diff)"
      },
      {
        "command": "ptnAgent.openReply",
        "title": "在编辑器中查看回答",
        "category": "AI Agent"
      }
    ],
    "submenus": [
      {
        "id": "ptnAgent.editorMenu",
        "label": "AI Agent"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "ptnAgent.editorMenu",
          "group": "ptnAgent@1"
        }
      ],
      "ptnAgent.editorMenu": [
        {
          "command": "ptnAgent.explainSelection",
          "when": "editorHasSelection",
          "group": "1_selection@1"
        },
        {
          "command": "ptnAgent.refactorSelection",
          "when": "editorHasSelection",
          "group": "1_selection@2"
        },
        {
          "command": "ptnAgent.generateTests",
          "when": "editorHasSelection",
          "group": "1_selection@3"
        },
        {
          "command": "ptnAgent.analyzeProblem",
          "group": "2_problems@1"
        },
        {
          "command": "ptnAgent.fixProblems",
          "group": "2_problems@2"
        },
        {
          "command": "ptnAgent.gotoProblem",
          "group": "2_problems@3"
        },
        {
          "command": "ptnAgent.openChat",
          "group": "3_chat@1"
        }
      ],
      "view/title": [
        {
          "command": "ptnAgent.newSession",
          "when": "view == ptnAgent.sessionView",
          "group": "navigation@1"
        },
        {
          "command": "ptnAgent.history",
          "when": "view == ptnAgent.sessionView",
          "group": "navigation@2"
        },
        {
          "command": "ptnAgent.settings",
          "when": "view == ptnAgent.sessionView",
          "group": "navigation@3"
        },
        {
          "command": "ptnAgent.stop",
          "when": "view == ptnAgent.sessionView && ptnAgent.busy",
          "group": "navigation@4"
        },
        {
          "command": "ptnAgent.openChat",
          "when": "view == ptnAgent.sessionView",
          "group": "1_chat@1"
        },
        {
          "command": "ptnAgent.undoLastPatch",
          "when": "view == ptnAgent.sessionView",
          "group": "1_chat@2"
        },
        {
          "command": "ptnAgent.showContext",
          "when": "view == ptnAgent.sessionView",
          "group": "2_context@1"
        },
        {
          "command": "ptnAgent.showProjectOutline",
          "when": "view == ptnAgent.sessionView",
          "group": "2_context@2"
        },
        {
          "command": "ptnAgent.runTests",
          "when": "view == ptnAgent.sessionView",
          "group": "3_run@1"
        },
        {
          "command": "ptnAgent.checkPi",
          "when": "view == ptnAgent.sessionView",
          "group": "4_env@1"
        }
      ],
      "view/item/context": [
        {
          "command": "ptnAgent.approval.diff",
          "when": "view == ptnAgent.sessionView && viewItem == approvalEdit",
          "group": "inline@0"
        },
        {
          "command": "ptnAgent.approval.allow",
          "when": "view == ptnAgent.sessionView && viewItem =~ /^approval/",
          "group": "inline@1"
        },
        {
          "command": "ptnAgent.approval.deny",
          "when": "view == ptnAgent.sessionView && viewItem =~ /^approval/",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "ptnAgent.explainSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "ptnAgent.refactorSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "ptnAgent.generateTests",
          "when": "editorHasSelection"
        },
        {
          "command": "ptnAgent.stop",
          "when": "ptnAgent.busy"
        },
        {
          "command": "ptnAgent.approval.allow",
          "when": "false"
        },
        {
          "command": "ptnAgent.approval.deny",
          "when": "false"
        },
        {
          "command": "ptnAgent.approval.diff",
          "when": "false"
        },
        {
          "command": "ptnAgent.openReply",
          "when": "false"
        },
        {
          "command": "ptnAgent.openTerminalChat",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ptnAgent.openChat",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i"
      },
      {
        "command": "ptnAgent.explainSelection",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorHasSelection"
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "shift+enter",
        "args": {
          "text": "\u001b\r"
        },
        "when": "terminalFocus && ptnAgent.chatActive"
      }
    ],
    "configuration": {
      "title": "PTN AI Coding Agent",
      "properties": {
        "ptnAgent.approvalMode": {
          "type": "string",
          "enum": [
            "ask",
            "autoEdit",
            "readOnly"
          ],
          "enumDescriptions": [
            "每次修改文件、运行命令都需要确认（推荐）",
            "工作区内的文件修改自动应用（可一键撤销），运行命令仍需确认",
            "只读：Agent 只能查看代码和诊断，不能修改文件或运行命令"
          ],
          "default": "ask",
          "description": "Agent 审批模式"
        },
        "ptnAgent.chatLocation": {
          "type": "string",
          "enum": [
            "beside",
            "panel"
          ],
          "enumDescriptions": [
            "对话作为一个标签页显示在编辑器右侧（推荐）",
            "对话显示在底部的终端面板里"
          ],
          "default": "beside",
          "description": "原生对话终端的位置，下次打开对话终端时生效"
        },
        "ptnAgent.baseUrl": {
          "type": "string",
          "default": "",
          "description": "模型服务的 API 地址（OpenAI 兼容接口，需包含版本路径，例如 https://api.example.com/v1）。建议通过命令「AI Agent: 打开设置」填写。"
        },
        "ptnAgent.model": {
          "type": "string",
          "default": "",
          "description": "模型名称，需要支持工具调用（function calling）。建议通过命令「AI Agent: 切换模型」从接口返回的列表里选择。"
        },
        "ptnAgent.contextWindow": {
          "type": "number",
          "default": 128000,
          "description": "模型上下文窗口大小（token）。Agent 会据此自动压缩过长的对话，请按所用模型实际能力填写"
        },
        "ptnAgent.maxOutputTokens": {
          "type": "number",
          "default": 8192,
          "description": "单次回复的最大输出 token 数"
        },
        "ptnAgent.runTimeoutMs": {
          "type": "number",
          "default": 600000,
          "description": "Agent 单次任务的最长运行时间（毫秒），超时自动停止"
        },
        "ptnAgent.maxContextLines": {
          "type": "number",
          "default": 400,
          "description": "单次发送的最大代码行数"
        },
        "ptnAgent.autoContext": {
          "type": "boolean",
          "default": true,
          "description": "自动附带当前文件与选区上下文"
        },
        "ptnAgent.platformUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "（管理员配置，学生无需填写）实训平台上下文接口地址，留空表示不连接平台"
        },
        "ptnAgent.systemPromptExtra": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "description": "自定义指令：追加到系统提示词，例如课程的代码规范"
        },
        "ptnAgent.includeProjectContext": {
          "type": "boolean",
          "default": true,
          "description": "在项目类问题中附带项目结构摘要"
        },
        "ptnAgent.allowedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Agent 可免确认执行的命令前缀，例如 npm test、dotnet build。含管道、&&、; 等 shell 元字符的命令仍需确认；高危命令一律拦截"
        },
        "ptnAgent.commandTimeoutMs": {
          "type": "number",
          "default": 120000,
          "description": "单条命令的最长执行时间（毫秒）"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "ptnAgent.sessionView",
        "when": "!ptnAgent.configured",
        "contents": "还没有连接模型服务。\n填写 API 地址、API Key 并选择模型后就可以开始。\n[配置模型服务](command:ptnAgent.settings)"
      },
      {
        "view": "ptnAgent.sessionView",
        "when": "ptnAgent.configured",
        "contents": "今天想一起完成什么？\n[打开对话窗口](command:ptnAgent.openChat)\n[输入任务…](command:ptnAgent.ask)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "tsc --noEmit -p ./",
    "check": "node scripts/check-policy.js && node scripts/check-commands.js && node scripts/check-session.js && node scripts/check-platform.js && node scripts/check-undo.js && node scripts/check-models.js && node scripts/check-pi-custom-provider.js && node scripts/check-agent.js && node scripts/check-chat.js && node scripts/check-tui.js && node scripts/smoke.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2"
  }
}
