{
  "name": "sxpt-agent",
  "displayName": "SXPT AI Coding Agent",
  "description": "实训平台内置 VS Code 的 AI 编程 Agent：自主查看代码、修改文件、运行命令并验证，所有修改经 Diff 审核、可一键撤销。",
  "version": "0.2.0",
  "publisher": "sxpt",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Education",
    "Other"
  ],
  "keywords": [
    "ai",
    "coding",
    "agent",
    "training",
    "education"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ptnAgent",
          "title": "AI Coding Agent",
          "icon": "media/agent.svg"
        }
      ]
    },
    "views": {
      "ptnAgent": [
        {
          "type": "webview",
          "id": "ptnAgent.chatView",
          "name": "代码助手"
        }
      ]
    },
    "commands": [
      {
        "command": "ptnAgent.openChat",
        "title": "AI Agent: 打开对话",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "ptnAgent.explainSelection",
        "title": "AI Agent: 解释选中代码"
      },
      {
        "command": "ptnAgent.analyzeProblem",
        "title": "AI Agent: 分析当前错误"
      },
      {
        "command": "ptnAgent.fixProblems",
        "title": "AI Agent: 修复当前问题"
      },
      {
        "command": "ptnAgent.generateTests",
        "title": "AI Agent: 生成单元测试"
      },
      {
        "command": "ptnAgent.explainProject",
        "title": "AI Agent: 理解项目结构"
      },
      {
        "command": "ptnAgent.refactorSelection",
        "title": "AI Agent: 重构选中代码"
      },
      {
        "command": "ptnAgent.settings",
        "title": "AI Agent: 打开设置"
      },
      {
        "command": "ptnAgent.newSession",
        "title": "AI Agent: 新建对话"
      },
      {
        "command": "ptnAgent.showContext",
        "title": "AI Agent: 查看当前上下文"
      },
      {
        "command": "ptnAgent.undoLastPatch",
        "title": "AI Agent: 撤销上次 AI 修改"
      },
      {
        "command": "ptnAgent.runTests",
        "title": "AI Agent: 运行测试或构建"
      },
      {
        "command": "ptnAgent.runCommand",
        "title": "AI Agent: 运行命令"
      },
      {
        "command": "ptnAgent.showProjectOutline",
        "title": "AI Agent: 查看项目结构摘要"
      },
      {
        "command": "ptnAgent.gotoProblem",
        "title": "AI Agent: 定位问题"
      },
      {
        "command": "ptnAgent.checkPi",
        "title": "AI Agent: 检查 Agent 运行环境"
      },
      {
        "command": "ptnAgent.pickMode",
        "title": "AI Agent: 切换审批模式"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ptnAgent.explainSelection",
          "when": "editorHasSelection",
          "group": "ptnAgent@1"
        },
        {
          "command": "ptnAgent.refactorSelection",
          "when": "editorHasSelection",
          "group": "ptnAgent@2"
        },
        {
          "command": "ptnAgent.generateTests",
          "when": "editorHasSelection",
          "group": "ptnAgent@3"
        },
        {
          "command": "ptnAgent.analyzeProblem",
          "group": "ptnAgent@4"
        },
        {
          "command": "ptnAgent.fixProblems",
          "group": "ptnAgent@5"
        },
        {
          "command": "ptnAgent.gotoProblem",
          "group": "ptnAgent@6"
        }
      ],
      "commandPalette": [
        {
          "command": "ptnAgent.explainSelection",
          "when": "editorHasSelection"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ptnAgent.openChat",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i"
      },
      {
        "command": "ptnAgent.explainSelection",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "PTN AI Coding Agent",
      "properties": {
        "ptnAgent.approvalMode": {
          "type": "string",
          "enum": [
            "ask",
            "autoEdit",
            "readOnly"
          ],
          "enumDescriptions": [
            "每次修改文件、运行命令都需要确认（推荐）",
            "工作区内的文件修改自动应用（可一键撤销），运行命令仍需确认",
            "只读：Agent 只能查看代码和诊断，不能修改文件或运行命令"
          ],
          "default": "ask",
          "description": "Agent 审批模式"
        },
        "ptnAgent.baseUrl": {
          "type": "string",
          "default": "",
          "description": "模型服务的 API 地址（OpenAI 兼容接口，需包含版本路径，例如 https://api.example.com/v1）。建议在侧栏「设置」页中填写。"
        },
        "ptnAgent.model": {
          "type": "string",
          "default": "",
          "description": "模型名称，需要支持工具调用（function calling）。建议在侧栏「设置」页中从接口返回的列表里选择。"
        },
        "ptnAgent.contextWindow": {
          "type": "number",
          "default": 128000,
          "description": "模型上下文窗口大小（token）。Agent 会据此自动压缩过长的对话，请按所用模型实际能力填写"
        },
        "ptnAgent.maxOutputTokens": {
          "type": "number",
          "default": 8192,
          "description": "单次回复的最大输出 token 数"
        },
        "ptnAgent.runTimeoutMs": {
          "type": "number",
          "default": 600000,
          "description": "Agent 单次任务的最长运行时间（毫秒），超时自动停止"
        },
        "ptnAgent.maxContextLines": {
          "type": "number",
          "default": 400,
          "description": "单次发送的最大代码行数"
        },
        "ptnAgent.autoContext": {
          "type": "boolean",
          "default": true,
          "description": "自动附带当前文件与选区上下文"
        },
        "ptnAgent.platformUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "（管理员配置，学生无需填写）实训平台上下文接口地址，留空表示不连接平台"
        },
        "ptnAgent.systemPromptExtra": {
          "type": "string",
          "default": "",
          "description": "自定义指令：追加到系统提示词，例如课程的代码规范"
        },
        "ptnAgent.includeProjectContext": {
          "type": "boolean",
          "default": true,
          "description": "在项目类问题中附带项目结构摘要"
        },
        "ptnAgent.allowedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Agent 可免确认执行的命令前缀，例如 npm test、dotnet build。含管道、&&、; 等 shell 元字符的命令仍需确认；高危命令一律拦截"
        },
        "ptnAgent.commandTimeoutMs": {
          "type": "number",
          "default": 120000,
          "description": "单条命令的最长执行时间（毫秒）"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "tsc --noEmit -p ./",
    "check": "node scripts/check-policy.js && node scripts/check-commands.js && node scripts/check-session.js && node scripts/check-platform.js && node scripts/check-undo.js && node scripts/check-models.js && node scripts/check-pi-custom-provider.js && node scripts/check-agent.js && node scripts/check-chat.js && node scripts/check-webview.js && node scripts/smoke.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2"
  }
}
